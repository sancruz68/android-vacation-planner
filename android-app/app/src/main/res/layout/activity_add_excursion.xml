<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#193F43"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VACATION PLANNER"
                android:textColor="#D5B78A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/textExcursionFormHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Add an Excursion"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Plan an activity for your vacation."
                android:textColor="#DBE8E5"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Excursion Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Excursion Details"
                android:textColor="#193F43"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Excursion Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Excursion Name"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editExcursionName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="e.g. Old San Juan Walking Tour"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:maxLength="100"
                android:backgroundTint="#637F7A" />

            <!-- Location -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Location"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editExcursionLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="e.g. Old San Juan, Puerto Rico"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:maxLength="120"
                android:backgroundTint="#637F7A" />

            <!-- Excursion Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Excursion Date"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonExcursionDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="Select Excursion Date"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#527570" />

            <!-- Save Excursion -->
            <Button
                android:id="@+id/buttonSaveExcursion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="Save Excursion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#193F43" />

            <!-- Delete Excursion -->
            <Button
                android:id="@+id/buttonDeleteExcursion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Delete Excursion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#A64D48"
                android:visibility="gone" />

            <!-- Cancel -->
            <Button
                android:id="@+id/buttonCancelExcursion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#788B88" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
