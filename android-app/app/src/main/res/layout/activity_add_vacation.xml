<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#193F43"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VACATION PLANNER"
                android:textColor="#D5B78A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/textFormHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Plan a new vacation"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Add the details for your upcoming trip."
                android:textColor="#DBE8E5"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Vacation Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vacation Details"
                android:textColor="#193F43"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- Vacation Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Vacation Name"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editVacationName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="e.g. Summer in Puerto Rico"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:maxLength="100"
                android:backgroundTint="#637F7A" />

            <!-- Destination -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Destination"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editDestination"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="e.g. San Juan, Puerto Rico"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:maxLength="120"
                android:backgroundTint="#637F7A" />

            <!-- Start Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Start Date"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonStartDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="Select Start Date"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#527570" />

            <!-- End Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="End Date"
                android:textColor="#193F43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonEndDate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:text="Select End Date"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#527570" />

            <!-- Save Vacation -->
            <Button
                android:id="@+id/buttonSaveVacation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="Save Vacation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#193F43" />

            <!-- Cancel -->
            <Button
                android:id="@+id/buttonCancelVacation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#788B88" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
