<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#193F43"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VACATION PLANNER"
                android:textColor="#D5B78A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Plan your next adventure."
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Keep your vacations, excursions, and important dates in one place."
                android:textColor="#DBE8E5"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

        <!-- Vacation List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Vacations"
                android:textColor="#193F43"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Organize your upcoming trips and travel plans."
                android:textColor="#657875"
                android:textSize="14sp" />

            <!-- Add Vacation Button -->
            <Button
                android:id="@+id/buttonAddVacation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Add Vacation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#193F43" />

            <!-- Saved Vacations -->
            <LinearLayout
                android:id="@+id/vacationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="28dp"
                    android:gravity="center"
                    android:text="No vacations yet.\n\nTap Add Vacation to start planning your first trip."
                    android:textColor="#657875"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:background="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
