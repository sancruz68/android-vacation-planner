<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Vacation Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#193F43"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VACATION PLANNER"
                android:textColor="#D5B78A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/textVacationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Vacation Name"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Destination"
                android:textColor="#DBE8E5"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trip Details"
                android:textColor="#193F43"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Dates Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Date"
                    android:textColor="#657875"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textStartDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Not selected"
                    android:textColor="#193F43"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="End Date"
                    android:textColor="#657875"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Not selected"
                    android:textColor="#193F43"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Vacation Actions -->
            <Button
                android:id="@+id/buttonEditVacation"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Edit Vacation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#193F43" />

            <Button
                android:id="@+id/buttonDeleteVacation"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="Delete Vacation"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#A64D48" />

            <!-- Excursions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="Excursions"
                android:textColor="#193F43"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keep track of activities planned for this vacation."
                android:textColor="#657875"
                android:textSize="14sp" />

            <Button
                android:id="@+id/buttonAddExcursion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="Add Excursion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#527570" />

            <LinearLayout
                android:id="@+id/excursionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emptyExcursions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="No excursions yet.\n\nAdd an activity to your vacation."
                    android:textColor="#657875"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

            <!-- Back Button -->
            <Button
                android:id="@+id/buttonBack"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:text="Back to Vacations"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#788B88" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
